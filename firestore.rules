rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if authenticated user belongs to the business workspace
    function hasBusinessAccess(businessId) {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/businesses/$(businessId)) &&
        (
          get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerUid == request.auth.uid ||
          request.auth.token.businessId == businessId
        )
      );
    }

    // User profile isolation
    match /users/{userId} {
      allow read, write: if isUser(userId);
    }

    // Business workspace document
    match /businesses/{businessId} {
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
      allow read, update, delete: if hasBusinessAccess(businessId);

      // Subcollections within business
      match /agents/{agentId} {
        allow read, write: if hasBusinessAccess(businessId);
      }

      match /knowledge/{knowledgeId} {
        allow read, write: if hasBusinessAccess(businessId);
      }

      match /documents/{docId} {
        allow read, write: if hasBusinessAccess(businessId);
      }

      match /threads/{threadId} {
        allow read, write: if hasBusinessAccess(businessId);

        match /messages/{messageId} {
          allow read, write: if hasBusinessAccess(businessId);
        }
      }

      match /rules/{ruleId} {
        allow read, write: if hasBusinessAccess(businessId);
      }

      match /subscription/{subId} {
        allow read: if hasBusinessAccess(businessId);
        allow write: if hasBusinessAccess(businessId);
      }

      match /sheets/{sheetId} {
        allow read, write: if hasBusinessAccess(businessId);
      }

      match /logs/{logId} {
        allow read, write: if hasBusinessAccess(businessId);
      }

      match /auditLogs/{logId} {
        allow read, create: if hasBusinessAccess(businessId);
      }
    }
  }
}
